# Managed by Ansible
[Unit]
Description=Dropbear loopback tunnel listener
After=network.target
[Service]
Type=simple
ExecStart=/usr/sbin/dropbear -E -F -w -g -r /etc/dropbear/dropbear_ed25519_host_key -b {{ dropbear_banner_path }} {% for p in dropbear_ports %}-p {{ dropbear_bind_address }}:{{ p }} {% endfor %}{{ '\n' }}Restart=always
RestartSec=2
LimitNOFILE=65535
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc /run /var/log
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_AUDIT_WRITE
# Dropbear must setuid to account users; NoNewPrivileges is intentionally absent.
[Install]
WantedBy=multi-user.target
