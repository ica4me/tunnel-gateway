[Unit]
Description=Ws-Epro relay
After=network.target dropbear-tunnel.service

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/local/bin/ws-epro -f /etc/tunnel/ws-epro.conf
Restart=always
RestartSec=2
LimitNOFILE={{ tuning_nofile | default(65535) }}
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
