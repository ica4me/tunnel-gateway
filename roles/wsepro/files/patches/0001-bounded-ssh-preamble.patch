+// readPreambleLine never buffers an unbounded or binary line.
+func readPreambleLine(br *bufio.Reader, budget *int) (string, error) {
+	var line []byte
+	for *budget > 0 {
+		b, err := br.ReadByte()
+		if err != nil { return "", err }
+		*budget--
+		line = append(line, b)
+		if b == '\n' {
+			if len(line) < 2 || line[len(line)-2] != '\r' {
+				return "", fmt.Errorf("preamble requires CRLF")
