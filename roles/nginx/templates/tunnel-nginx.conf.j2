# Managed by Ansible
server {
    listen 127.0.0.1:8080;
    server_name _;
    server_tokens off;
    root {{ camouflage_root }};
    location /.well-known/acme-challenge/ { root {{ camouflage_root }}; }
    location / { try_files $uri $uri/ =404; }
}

server {
    listen 127.0.0.1:10010 http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    grpc_set_header X-Forwarded-For $proxy_protocol_addr;
    grpc_set_header x-stage0-trusted 1;
    location {{ xray_grpc_names.vmess | default('/vmess-grpc') | regex_replace('^', '/') | regex_replace('^//', '/') }} { grpc_pass grpc://127.0.0.1:10011; }
    location {{ xray_grpc_names.vless | default('/vless-grpc') | regex_replace('^', '/') | regex_replace('^//', '/') }} { grpc_pass grpc://127.0.0.1:10012; }
    location {{ xray_grpc_names.trojan | default('/trojan-grpc') | regex_replace('^', '/') | regex_replace('^//', '/') }} { grpc_pass grpc://127.0.0.1:10013; }
}
