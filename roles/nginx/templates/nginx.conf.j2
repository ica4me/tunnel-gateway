# Managed by Ansible
user www-data;
worker_processes auto;
worker_rlimit_nofile {{ tuning_nofile | default(65535) }};
pid /run/nginx.pid;
events { worker_connections 4096; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
{% if gateway_quiet_logs | default(true) | bool %}
  access_log off;
  error_log /var/log/nginx/error.log crit;
{% else %}
  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log;
{% endif %}
  sendfile on;
  server {
    listen 127.0.0.1:{{ nginx_web_port }};
    server_name _;
    root {{ nginx_camouflage_root }};
    location /.well-known/acme-challenge/ { root {{ nginx_acme_root }}; }
    location / { try_files $uri $uri/ =404; }
  }
  server {
{% if nginx_detected_version is version('1.25.1', '>=') %}
    listen 127.0.0.1:{{ nginx_h2c_port }} proxy_protocol;
    http2 on;
{% else %}
    listen 127.0.0.1:{{ nginx_h2c_port }} http2 proxy_protocol;
{% endif %}
    server_name _;
    root {{ nginx_camouflage_root }};
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    grpc_set_header X-Forwarded-For $proxy_protocol_addr;
    grpc_set_header x-stage0-trusted 1;
    grpc_set_header CF-Connecting-IP "";
{% for proto in ['vmess', 'vless', 'trojan'] %}
    location /{{ xray_grpc_names[proto] }}/ {
      grpc_read_timeout 1h;
      grpc_send_timeout 1h;
      grpc_pass grpc://127.0.0.1:{{ xray_grpc_ports[proto] }};
    }
{% endfor %}
    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
